<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application
        android:name=".RadioApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@drawable/radio_icon"
        android:label="@string/app_name"
        android:theme="@style/RadioTheme"
        android:usesCleartextTraffic="true">
        <meta-data android:name="org.openvoyah.controls.PANEL_ICON" android:resource="@drawable/radio_icon" />
        <activity
            android:name=".ui.RadioActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".ui.RadioSettingsActivity" android:exported="false" />
        <service
            android:name=".playback.RadioService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />
        <!-- The head unit's home screen media card connects here. The permission is a platform one that only system
             apps hold (the launcher runs as the system uid); onGetRoot also accepts only the system uid. -->
        <service
            android:name=".playback.RadioBrowserService"
            android:exported="true"
            android:permission="android.permission.MEDIA_CONTENT_CONTROL">
            <intent-filter>
                <action android:name="android.media.browse.MediaBrowserService" />
            </intent-filter>
        </service>
        <provider
            android:name=".update.UpdateFiles"
            android:authorities="${applicationId}.updates"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>
</manifest>
